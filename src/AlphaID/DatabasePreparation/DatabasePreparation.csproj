<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
		可复用的「数据库准备」抽象：把建库流程拆成按 DbContext 装配的初始化单元，
		再由统一执行器按阶段顺序驱动它们。

		本工程**刻意保持零业务耦合**，以便整目录复制到其他解决方案或作为独立 NuGet 包发布：

		- 没有任何 ProjectReference——不认识任何业务工程、不知道有哪些 DbContext；
		- 不引用任何数据库提供程序包（SqlServer / Npgsql / …）——删库与迁移只用 EF Core 的
		  DatabaseFacade，具体是哪个数据库由调用方决定；
		- 「灌什么内置数据 / 样例数据」通过委托从外部注入，业务概念不进来。

		因此新增一个业务概念时，请**不要**往这里加——那正是本工程需要保持的边界。
		AlphaID 的那一层适配在 AlphaId.DatabasePreparation 工程；把两者合并会毁掉可复用性。
	-->
	<ItemGroup>
		<!-- EnsureDeletedAsync / MigrateAsync 属于关系型扩展；它是本工程唯一的 EF 依赖。 -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkCoreVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(EntityFrameworkCoreVersion)" />
	</ItemGroup>

</Project>
