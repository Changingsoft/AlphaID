<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--
		本工具不含任何建库逻辑，只引用 AlphaId.DatabasePreparation 这一层适配：
		上下文装配、迁移、内置数据与样例数据都由它提供，与集成测试共用同一份实现。
		样例数据（AlphaId.TestingData）经由它间接引用，仅在 AddTestingData 打开时才会写入。
	-->
	<ItemGroup>
		<ProjectReference Include="..\AlphaId.DatabasePreparation\AlphaId.DatabasePreparation.csproj" />
	</ItemGroup>

	<!--
		本工程是 Add-Migrations.ps1 的启动工程：dotnet ef 靠它构造设计时服务，
		因此需要 Microsoft.EntityFrameworkCore.Design（不流向引用者）。
		上下文与迁移所需的其他包经 AlphaId.DatabasePreparation 传递而来。
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkCoreVersion)">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
